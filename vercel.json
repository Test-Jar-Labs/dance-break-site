{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/((?!api/|images/|video/|assets/|favicon|robots.txt|sitemap.xml).*)", "destination": "/index.html" }
  ],
  "redirects": [
    { "source": "/cart", "destination": "/", "permanent": true }
  ]
}
